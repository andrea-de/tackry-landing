{
  "redirects": [
    { "source": "/press-new/:rest*", "destination": "/press", "statusCode": 301 },
    { "source": "/drafts-new/:rest*", "destination": "/drafts", "statusCode": 301 }
  ],
  "headers": [
    {
      "source": "/(press|drafts)(/.*)?",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    }
  ]
}
